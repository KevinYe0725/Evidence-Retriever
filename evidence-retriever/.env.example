MYSQL_DSN=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/YOUR_DATABASE
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=evidence_chunks
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
QWEN_EMBEDDING_TIMEOUT_SECONDS=30
ENABLE_RERANK=false
QWEN_RERANK_BASE_URL=https://api.siliconflow.cn/v1
QWEN_RERANK_MODEL=BAAI/bge-reranker-v2-m3
QWEN_RERANK_TIMEOUT_SECONDS=30
